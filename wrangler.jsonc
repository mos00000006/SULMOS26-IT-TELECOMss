
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sulmos26-it-telecom",
  "main": "src/index.js",
  "compatibility_date": "2026-11-10",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sulmos26-it-telecom-db",
      "database_id": "a0a926e2-e107-4e01-9ba6-75823b22750e",
      "migrations_dir": "migrations"
    }
  ]
}
  
